# Django Backend Environment Variables

# SECURITY WARNING: Generate a unique secret key for production!
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# Set to True for development, False for production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts for your Django application
# Examples: 
#   For production: mdoa-tools.bi.denbi.de,multiomics-visualizer.isas.de
#   For development: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
